---
import Layout from '../layouts/Layout.astro';

const year = new Date().getFullYear();
const mailto = 'mailto:raj@zen-scale.io?subject=Project%20enquiry';
const booking = 'https://cal.com/zenscale/intro';
---

<Layout
  title="Zen Scale · AI engineering studio in London"
  description="AI features, web and mobile apps, and the infrastructure behind them, built and run by Raj Gurung, an engineer who took generative AI live in NHS hospitals."
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap">
      <a class="mark" href="#top"><b aria-hidden="true"></b>Zen Scale</a>
      <nav aria-label="Main">
        <a href="#proof">Proof</a><a href="#services">Services</a><a href="#work">Work</a><a href="#process">Process</a><a href="#about">About</a>
        <a class="nav-cta" href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="band hero" id="top" data-scope>
    <div class="sun pl" style="--d:40" aria-hidden="true"></div>
    <div class="wrap">
      <span class="pill">AI engineering studio · London</span>
      <h1>AI-powered software, built and run by <span>the engineer you talk to.</span></h1>
      <p class="lede">I build AI features, web and mobile apps, and the infrastructure behind them for startups and SMEs, then stay on to keep them running. Most recently I built an automated AI pipeline that drafts radiology reports, now live in NHS hospitals.</p>
      <div class="ctas"><a class="btn primary" href={mailto}>Email me</a><a class="btn" href={booking} target="_blank" rel="noopener">Book a free call</a></div>
      <div class="who"><span class="av" aria-hidden="true">R</span>Raj Gurung, founder. 15 years building production software.</div>
    </div>
  </div>

  <main id="main">
    <section id="proof" class="sec">
      <div class="wrap">
        <div class="head"><span class="eyebrow">01 · Proof</span><h2>Systems I've built and run in production.</h2><p>Before Zen Scale I was a technical lead at Hexarad and Indeed. Here's what I built there.</p></div>
        <div class="cases">
          <article class="case">
            <b class="fig">AI orchestration</b>
            <h3>An AI that drafts radiology reports, live in five months.</h3>
            <p>I designed and built the system around it. Safety checks decide which CT scans the AI may draft. A broker I built on AWS sends each case to a vision-language model. A radiologist reviews every draft, and each one is scored against their final report. It now runs in live NHS clinical workflows.</p>
            <span class="case-meta">Hexarad · Technical lead</span>
          </article>
          <article class="case">
            <b class="fig">Built to scale</b>
            <h3>From five-minute timeouts to under a second.</h3>
            <p>On a hiring platform serving 12M+ requests a week, I rewrote the slowest core queries. One went from timing out after five minutes to 0.7 seconds. I also built AI-driven workforce orchestration: an ML model, business rules and timed states decide when each shift goes out to staffing agencies.</p>
            <span class="case-meta">Indeed · Technical lead</span>
          </article>
          <article class="case">
            <b class="fig">Reliable by design</b>
            <h3>Eight years keeping a growing platform stable.</h3>
            <p>I joined Syft in 2017 and stayed through its acquisition by Indeed. I owned the agency portal and much of the employer side. I added the monitoring, retries and repair jobs that kept production healthy as usage grew.</p>
            <span class="case-meta">Syft → Indeed · Senior engineer</span>
          </article>
        </div>
        <div class="quote-grid">
          <figure class="quote">
            <blockquote>Raj is the rare engineer who is as aware of the human element of software development as he is the technical. … I wouldn't hesitate to work with him again.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/jonathan-e-barrett/" target="_blank" rel="noopener">Jonathan Barrett</a><span>Engineering Manager at Indeed, managed Raj</span></figcaption>
          </figure>
          <figure class="quote">
            <blockquote>An exceptional engineering partner: proactive, responsive, and always willing to jump in to help solve problems. He brings clarity to complex situations.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/palak13/" target="_blank" rel="noopener">Palak Jain</a><span>Senior Product Manager, worked with Raj</span></figcaption>
          </figure>
          <figure class="quote">
            <blockquote>Raj has this rare ability to understand complex business logic and then build elegant solutions around it. … He brings technical skill, yes, but also the kind of thoughtful leadership and collaborative spirit that lifts everyone around him.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/davidslv/" target="_blank" rel="noopener">David Silva</a><span>Senior Backend Engineer at Indeed, worked with Raj</span></figcaption>
          </figure>
        </div>
        <p class="nudge">Want this for your product? <a href={booking} target="_blank" rel="noopener">Book a free call →</a></p>
      </div>
    </section>

    <section id="services" class="sec tint">
      <div class="wrap">
        <div class="head"><span class="eyebrow">02 · Services</span><h2>What I can do for you.</h2><p>From the first idea to running in production.</p></div>
        <div class="tiles">
          <div class="tile">
            <div class="art art-ai" role="img" aria-label="A chat where the AI reads a contract, answers, and creates a task">
              <div class="ask">Pull the renewal date from this contract</div>
              <div class="reply"><span class="spark"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10213A" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/></svg></span><div><span>Renews on <b>1 March</b>, 60 days' notice.</span><i class="bar" style="width:70%"></i></div></div>
              <div class="ai-chips"><span class="chip ok">✓ Task created via MCP</span><span class="chip">Eval: passed</span></div>
            </div>
            <h3>AI in your product</h3><p>Add Claude or OpenAI to your product: smart suggestions, document extraction, search over your own content, and agents that take real actions through MCP. Tested so the answers stay reliable.</p><small>Claude · OpenAI · MCP · evals</small></div>
          <div class="tile">
            <div class="art art-apps" role="img" aria-label="The same product as a web app in a browser and as a phone app">
              <div class="browser">
                <div class="chrome"><i class="dot" style="background:#FF8A7A"></i><i class="dot" style="background:#FFC53D"></i><i class="dot" style="background:#6FD08F"></i><i class="url"></i></div>
                <div class="page">
                  <div class="side"><i class="bar" style="width:80%"></i><i class="bar"></i><i class="bar" style="width:70%"></i><i class="bar" style="width:85%"></i></div>
                  <div class="content"><i class="heading"></i><div class="cards"><i></i><i></i><i></i></div><i class="bar"></i><i class="bar" style="width:80%"></i></div>
                </div>
              </div>
              <div class="mini-phone"><div class="screen"><i class="heading"></i><i class="mini-hero"></i><i class="bar"></i><i class="bar" style="width:75%"></i><i class="cta"></i></div></div>
            </div>
            <h3>Web and mobile apps</h3><p>Full products from database to App Store. Customer portals, internal tools, SaaS, and iPhone and Android apps from one codebase.</p><small>Rails · Next.js · React Native</small></div>
          <div class="tile">
            <div class="art art-infra" role="img" aria-label="A status panel showing web, database, backups and deploys all healthy, with response time steady below the alert line">
              <div class="svc-status">
                <div><i class="dot up"></i><span>Web</span><span class="good">Healthy</span></div>
                <div><i class="dot up"></i><span>Database</span><span class="good">Healthy</span></div>
                <div><i class="dot up"></i><span>Backups</span><span class="meta">03:00 ✓</span></div>
                <div><i class="dot live"></i><span>Deploy</span><span class="meta">Live</span></div>
              </div>
              <div class="chart"><span>Response time · 24h</span><svg viewBox="0 0 200 80" aria-hidden="true"><path class="area" d="M0 58 L14 54 L28 56 L42 50 L56 52 L70 47 L84 49 L98 44 L112 46 L126 42 L140 44 L154 40 L168 42 L182 38 L200 40 L200 80 L0 80 Z"/><path class="line" d="M0 58 L14 54 L28 56 L42 50 L56 52 L70 47 L84 49 L98 44 L112 46 L126 42 L140 44 L154 40 L168 42 L182 38 L200 40"/><line class="alert" x1="0" y1="22" x2="200" y2="22"/><text x="200" y="16" text-anchor="end">alert line</text></svg></div>
            </div>
            <h3>Infrastructure that stays up</h3><p>I set up and run it all: cloud, databases, deploys, monitoring, backups and security. Clear uptime targets and alerts, so problems get fixed before your users notice.</p><small>AWS · Terraform · Cloudflare</small></div>
          <div class="tile">
            <div class="art art-pr" role="img" aria-label="A pull request moving a slow query into the database, approved by the team">
              <div class="pr-head"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--blue)" aria-hidden="true"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v7M18 15.5V10a3 3 0 0 0-3-3h-4M13 4.5 10.5 7 13 9.5"/></svg><b>Move slow report query into Postgres</b><span class="add">+12</span><span class="del">−48</span></div>
              <div class="diff"><div class="minus">− rows.select {'{'} |r| r.shift.open? {'}'}</div><div class="plus">+ Shift.open.where(agency_id: id)</div></div>
              <div class="review"><span class="faces"><i>R</i><i></i><i></i></span><span>Your team reviewed</span><span class="chip ok">Approved</span></div>
            </div>
            <h3>A senior engineer in your team</h3><p>Architecture, hard bugs, performance, and getting stuck projects moving. I can also help your team adopt Claude Code and AI coding agents safely.</p><small>Rails · TypeScript · Go · Claude Code</small></div>
        </div>
      </div>
    </section>

    <section id="work" class="sec">
      <div class="wrap">
        <div class="head"><span class="eyebrow">03 · Work</span><h2>Products I've built and run.</h2><p>Each one is calm to use: a few clear screens, plain labels, and one obvious next step. You can try them today.</p></div>
        <article class="product" data-scope>
          <div class="copy">
            <span class="status">● Live on web · iOS coming soon</span>
            <h3>Softly. Life admin, handled softly.</h3>
            <p>A task manager for bills, appointments and renewals. Type or say a task in your own words and AI turns it into a reminder, then suggests what's due next.</p>
            <div class="chips"><span>Claude</span><span>Voice input</span><span>React Native</span></div>
            <a class="btn" href="https://mysoftly.app" target="_blank" rel="noopener">Visit mysoftly.app ↗</a>
          </div>
          <div class="stage">
            <div class="blob pl" style="--d:8" aria-hidden="true"></div>
            <div class="pl" style="--d:18"><div class="phone"><img src="/images/softly-home.jpg" width="414" height="900" alt="Softly home screen showing suggestions and upcoming tasks"></div></div>
            <div class="float f1 pl" style="--d:34" aria-hidden="true"><b>Renew car insurance</b><span>Wed 10 Jun · Car</span></div>
            <div class="float f2 pl" style="--d:42" aria-hidden="true"><b>Pay rent</b><span>Tue 30 Jun · Finance</span></div>
          </div>
        </article>
        <div class="more">
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/collab.jpg" width="1100" height="687" loading="lazy" alt="Collab task board with swimlanes for three projects"></div>
              <div class="bubble pl" style="--d:26" aria-hidden="true"><i>M</i><span>Draft is ready. <b>@raj</b> can you look?</span></div>
            </div>
            <div class="mini-copy">
              <h3>Collab</h3>
              <p>One workspace for small teams: roadmap, tasks, notes and chat. Connect Claude and it plans and updates tasks for you.</p>
              <div class="chips"><span>Rust</span><span>HTMX</span><span>MCP</span></div>
              <a class="go" href="https://collab.zen-scale.io" target="_blank" rel="noopener">Try Collab ↗</a>
            </div>
          </article>
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/compress.jpg" width="1100" height="733" loading="lazy" alt="Compress home screen: make PDFs and JPGs smaller, nothing is uploaded"></div>
              <div class="bubble lock pl" style="--d:26" aria-hidden="true"><i>✓</i><span>Files stay on your device</span></div>
            </div>
            <div class="mini-copy">
              <h3>Compress</h3>
              <p>Make PDFs and JPGs smaller right in your browser. Files never leave your device, and it works offline.</p>
              <div class="chips"><span>WebAssembly</span><span>Offline</span><span>Open source</span></div>
              <a class="go" href="https://compress.zen-scale.io" target="_blank" rel="noopener">Try Compress ↗</a>
            </div>
          </article>
          <article class="mini game" data-scope>
            <div class="g-stage">
              <div class="g-glow" aria-hidden="true"></div>
              <div class="g-title pl" style="--d:6" aria-hidden="true">Warden<br>Zero</div>
              <div class="g-enemy left pl" style="--d:14" aria-hidden="true"><img src="/images/grunt.webp" width="256" height="256" loading="lazy" alt=""></div>
              <div class="g-enemy right pl" style="--d:14" aria-hidden="true"><img src="/images/runner.webp" width="256" height="256" loading="lazy" alt="" style="transform:scaleX(-1)"></div>
              <div class="g-hero pl" style="--d:26"><img src="/images/warden.webp" width="900" height="1196" loading="lazy" alt="The Warden, an armoured soldier holding a rifle"></div>
              <div class="g-fade" aria-hidden="true"></div>
            </div>
            <div class="mini-copy">
              <h3>Warden Zero</h3>
              <p>An arena shooter that runs in your browser. Survive eight waves and bring down the Colossus.</p>
              <div class="chips"><span>Unity 6</span><span>WebGL</span><span>Touch</span></div>
              <a class="go" href="https://rajgurung.me/game" target="_blank" rel="noopener">Play it ↗</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="process" class="sec tint">
      <div class="wrap">
        <div class="head"><span class="eyebrow">04 · How it works</span><h2>How a project runs.</h2></div>
        <ol class="steps">
          <li><h3>Talk</h3><p><a href={booking} target="_blank" rel="noopener">Book a free 30-minute call</a>, or email me.</p></li>
          <li><h3>Scope</h3><p>A written plan with milestones and a fixed price. Projects start from £5k.</p></li>
          <li><h3>Build</h3><p>Working software every week that you can click through.</p></li>
          <li><h3>Run and support</h3><p>I deploy it, monitor it and keep improving it as you grow, from £500 a month. Same engineer, no handover.</p></li>
        </ol>
        <p class="nudge">Want this for your product? <a href={booking} target="_blank" rel="noopener">Book a free call →</a></p>
      </div>
    </section>

    <section id="about" class="sec">
      <div class="wrap about">
        <div class="head"><img class="headshot" src="/images/raj.webp" alt="Raj Gurung" width="400" height="400" loading="lazy" /><span class="eyebrow">05 · About</span><h2>Hi, I'm Raj.</h2></div>
        <div class="letter">
          <p>I started Zen Scale to build software the way I like to work: carefully, in plain English, with no layers between you and the engineer.</p>
          <p>Most of my work today is AI: LLM features in production, MCP connectors, and engineering with Claude every day, with the reviews and tests that keep it trustworthy.</p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <div class="box">
          <h2>Tell me what you're building.</h2>
          <ul class="prompts">
            <li>What your product does</li>
            <li>What you need: AI, an app, infrastructure or ongoing support</li>
            <li>Your timeline and rough budget</li>
          </ul>
          <div class="email-row"><a class="email" id="email" href={mailto}>raj@zen-scale.io</a><button class="copy-btn" id="copy" type="button">Copy</button></div>
          <a class="book-btn" href={booking} target="_blank" rel="noopener">Or book a free 30-minute call →</a>
          <p class="hint">I reply within one working day. Projects from £5k · ongoing support from £500 a month.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div>ZEN SCALE LTD · Registered in England &amp; Wales · Company no. 16398455<br>71–75 Shelton Street, Covent Garden, London WC2H 9JQ</div>
      <div>© {year} Zen Scale Ltd</div>
    </div>
  </footer>
  <script is:inline>
  document.querySelectorAll('[data-scope]').forEach(function (el) {
    var frame = 0;
    el.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var x = e.clientX, y = e.clientY;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(function () {
        var r = el.getBoundingClientRect();
        el.style.setProperty('--px', ((x - r.left) / r.width - 0.5).toFixed(3));
        el.style.setProperty('--py', ((y - r.top) / r.height - 0.5).toFixed(3));
      });
    });
    el.addEventListener('pointerleave', function () { el.style.setProperty('--px', 0); el.style.setProperty('--py', 0); });
  });

  // Highlight the nav link for the section in view.
  var links = {};
  document.querySelectorAll('nav a[href^="#"]').forEach(function (a) { links[a.getAttribute('href').slice(1)] = a; });
  // The hero and sections without a nav link clear the highlight.
  var sections = Array.prototype.slice.call(document.querySelectorAll('main section'));
  var ticking = false;
  // A clicked link stays highlighted until the visitor scrolls themselves.
  // Near the page bottom a short section can't reach the top, so position alone would pick the wrong one.
  var pinned = null;
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a[href^="#"]');
    if (!a) return;
    var id = a.getAttribute('href').slice(1);
    pinned = links[id] ? document.getElementById(id) : null;
    spy();
  });
  ['wheel', 'touchstart', 'keydown'].forEach(function (e) {
    addEventListener(e, function () { pinned = null; }, { passive: true });
  });
  function spy() {
    ticking = false;
    var current = null;
    sections.forEach(function (s) { if (s.getBoundingClientRect().top <= innerHeight * 0.4) current = s; });
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections[sections.length - 1];
    if (pinned) current = pinned;
    Object.keys(links).forEach(function (id) {
      if (current && current.id === id) links[id].setAttribute('aria-current', 'true');
      else links[id].removeAttribute('aria-current');
    });
  }
  addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(spy); } }, { passive: true });
  addEventListener('resize', spy);
  spy();

  document.getElementById('copy').addEventListener('click', function () {
    var b = this;
    function sel() { var r = document.createRange(); r.selectNodeContents(document.getElementById('email')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Selected'; }
    try { navigator.clipboard.writeText('raj@zen-scale.io').then(function () { b.textContent = 'Copied'; }, sel); } catch (e) { sel(); }
  });

  // Booking links open Cal.com in a pop-up. The embed script loads only when someone shows
  // intent (hover, focus, tap), so other visitors never contact Cal.com. If the script
  // fails, the link goes to cal.com as before.
  var calLink = 'zenscale/intro';
  var calState = 'idle';
  var calPending = null;
  function loadCal() {
    if (calState !== 'idle') return;
    calState = 'loading';
    // Cal.com's queue stub: calls made before embed.js loads are replayed once it does.
    window.Cal = function () {
      var cal = window.Cal, ar = arguments;
      if (ar[0] === 'init') {
        var api = function () { api.q.push(arguments); };
        api.q = [];
        cal.ns[ar[1]] = cal.ns[ar[1]] || api;
        cal.ns[ar[1]].q.push(ar);
        cal.q.push(['initNamespace', ar[1]]);
        return;
      }
      cal.q.push(ar);
    };
    Cal.ns = {}; Cal.q = []; Cal.loaded = true;
    Cal('init', 'intro', { origin: 'https://cal.com' });
    var dark = matchMedia('(prefers-color-scheme: dark)').matches;
    Cal.ns.intro('ui', { theme: dark ? 'dark' : 'light', cssVarsPerTheme: { light: { 'cal-brand': '#2B6BE6' }, dark: { 'cal-brand': '#7FAAFF' } }, layout: 'month_view' });
    var s = document.createElement('script');
    s.src = 'https://app.cal.com/embed/embed.js';
    s.onload = function () { calState = 'ready'; calPending = null; };
    s.onerror = function () {
      calState = 'failed';
      if (calPending) location.href = calPending;
    };
    document.head.appendChild(s);
  }
  document.querySelectorAll('a[href="https://cal.com/' + calLink + '"]').forEach(function (a) {
    ['pointerenter', 'focus', 'touchstart'].forEach(function (e) { a.addEventListener(e, loadCal, { passive: true }); });
    a.addEventListener('click', function (e) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0 || calState === 'failed') return;
      e.preventDefault();
      loadCal();
      if (calState === 'loading') calPending = a.href;
      Cal.ns.intro('modal', { calLink: calLink, config: { layout: 'month_view' } });
    });
  });
  </script>
</Layout>
