---
import Layout from '../layouts/Layout.astro';

const year = new Date().getFullYear();
---

<Layout
  title="Zen Scale · AI-first software studio in London"
  description="Zen Scale builds AI-powered web and mobile apps, connects products to LLMs like Claude, and runs the infrastructure behind them. Work directly with the founder, from the first call to launch and beyond."
>
  <a class="skip" href="#main">Skip to content</a>
  <div class="band" data-scope>
    <div class="sun pl" style="--d:40" aria-hidden="true"></div>
    <header>
      <div class="wrap">
        <a class="mark" href="#top"><b aria-hidden="true"></b>Zen Scale</a>
        <nav aria-label="Main"><a href="#work">Work</a><a href="#services">Services</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
      </div>
    </header>
    <div class="hero" id="top">
      <div class="wrap">
        <span class="pill">AI-first software studio · London</span>
        <h1>Software that's easy to use, built by the person <span>you talk to.</span></h1>
        <p class="lede">Zen Scale builds AI-powered web and mobile apps, connects your product to LLMs like Claude, and sets up and runs the infrastructure behind it. You work directly with the founder from the first call to launch day, and we stay with you as you grow.</p>
        <div class="ctas"><a class="btn primary" href="#contact">Start a project</a><a class="btn" href="#work">See our work</a></div>
        <div class="who"><span class="av" aria-hidden="true">R</span>Raj Gurung, founder. 15+ years shipping production software.</div>
      </div>
    </div>
  </div>

  <main id="main">
    <section id="work">
      <div class="wrap">
        <div class="head"><h2>Things we've built and shipped.</h2><p>Before we build for clients, we build for ourselves. Each of these is designed, engineered and run end to end by Zen Scale, and you can use them today.</p></div>
        <article class="product" data-scope>
          <div class="copy">
            <span class="status">● Live on web · iOS coming soon</span>
            <h3>Softly. Life admin, handled softly.</h3>
            <p>A task manager for the things life keeps throwing at you: bills, appointments, renewals. Type or say a task in your own words and AI turns it into a reminder. It also suggests what's due next, so you don't have to remember.</p>
            <div class="chips"><span>Claude</span><span>Voice input</span><span>Rails 8.1</span><span>React Native</span><span>Next.js 16</span><span>Railway</span><span>Cloudflare</span></div>
            <a class="btn" href="https://mysoftly.app" target="_blank" rel="noopener">Visit mysoftly.app ↗</a>
          </div>
          <div class="stage">
            <div class="blob pl" style="--d:8" aria-hidden="true"></div>
            <div class="pl" style="--d:18"><div class="phone"><img src="/images/softly-home.jpg" width="414" height="900" alt="Softly home screen showing suggestions and upcoming tasks"></div></div>
            <div class="float f1 pl" style="--d:34" aria-hidden="true"><b>Renew car insurance</b><span>Wed 10 Jun · Car</span></div>
            <div class="float f2 pl" style="--d:42" aria-hidden="true"><b>Pay rent</b><span>Tue 30 Jun · Finance</span></div>
          </div>
        </article>
        <div class="more">
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/collab.jpg" width="1100" height="687" loading="lazy" alt="Collab task board with swimlanes for launch, mobile app and brand refresh projects"></div>
              <div class="bubble pl" style="--d:26" aria-hidden="true"><i>M</i><span>Draft is ready. <b>@raj</b> can you take a look?</span></div>
            </div>
            <div class="mini-copy">
              <span class="status">● Live</span>
              <h3>Collab</h3>
              <p>One workspace for small teams. Roadmap, task board, meeting notes and live chat in one place. Connect Claude and it can plan and update tasks for you.</p>
              <div class="chips"><span>Rust</span><span>Loco</span><span>HTMX</span><span>Postgres</span><span>MCP</span></div>
              <a class="go" href="https://collab.rajgurung.me" target="_blank" rel="noopener">Try Collab ↗</a>
            </div>
          </article>
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/compress.jpg" width="1100" height="733" loading="lazy" alt="Compress home screen: make PDFs and JPGs smaller, nothing is uploaded"></div>
              <div class="bubble lock pl" style="--d:26" aria-hidden="true"><i>✓</i><span>Your files stay on your device</span></div>
            </div>
            <div class="mini-copy">
              <span class="status">● Live · Open source</span>
              <h3>Compress</h3>
              <p>Make PDFs and JPGs smaller right in your browser. Files never leave your device. Compression runs locally in WebAssembly and works offline.</p>
              <div class="chips"><span>WebAssembly</span><span>Ghostscript</span><span>mozjpeg</span><span>Cloudflare</span></div>
              <a class="go" href="https://compress.rajgurung.me" target="_blank" rel="noopener">Try Compress ↗</a>
            </div>
          </article>
        </div>
        <article class="game" data-scope>
          <div class="g-stage">
            <div class="g-glow" aria-hidden="true"></div>
            <div class="g-title pl" style="--d:6" aria-hidden="true">Warden<br>Zero</div>
            <div class="g-enemy left pl" style="--d:14" aria-hidden="true"><img src="/images/grunt.webp" width="256" height="256" loading="lazy" alt=""></div>
            <div class="g-enemy right pl" style="--d:14" aria-hidden="true"><img src="/images/runner.webp" width="256" height="256" loading="lazy" alt="" style="transform:scaleX(-1)"></div>
            <div class="g-hero pl" style="--d:26"><img src="/images/warden.webp" width="900" height="1196" loading="lazy" alt="The Warden, an armoured soldier holding a rifle"></div>
            <div class="g-fade" aria-hidden="true"></div>
          </div>
          <div class="g-copy">
            <span class="g-status">● Playable in your browser · Beta</span>
            <h3>Warden Zero</h3>
            <p>A chaotic arena shooter. Survive eight waves, level up, and bring down the Colossus. Rebuilt three times, from Phaser to Babylon.js to Unity 6, to push the graphics further each time.</p>
            <div class="chips"><span>Unity 6</span><span>C#</span><span>WebGL</span><span>Touch controls</span></div>
            <a class="g-play" href="https://rajgurung.me/game" target="_blank" rel="noopener">▶ Play Warden Zero</a>
          </div>
        </article>
      </div>
    </section>

    <section class="calm">
      <div class="wrap">
        <div class="head"><h2>Why "Zen"?</h2><p>Everything we build should feel calm to use. Here's what that means in practice.</p></div>
        <div class="calm-grid">
          <div class="calm-item">
            <h3>Easy to find your way</h3>
            <p>A few clear screens with plain labels. You always know where you are and how to get back.</p>
            <small>Collab fits a whole team workspace into four tabs on your phone.</small>
          </div>
          <div class="calm-item">
            <h3>Easy on the eyes</h3>
            <p>Plenty of space, soft colours, and light and dark modes. No clutter and no pop-ups fighting for your attention.</p>
            <small>Every app follows your phone's light or dark setting.</small>
          </div>
          <div class="calm-item">
            <h3>Easy to use</h3>
            <p>One obvious next step on every screen. The app does the remembering, so you don't have to.</p>
            <small>Compress is one screen and one button. Softly suggests what's due next.</small>
          </div>
        </div>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <div class="head"><h2>What we can do for you.</h2><p>AI first, from the idea to running in production.</p></div>
        <div class="tiles">
          <div class="tile"><h3>AI features and LLMs</h3><p>Add Claude or OpenAI to your product. Smart suggestions, document and data extraction, search over your own content, and chat that knows your business. Tested so the answers stay reliable.</p><small>Claude · OpenAI · embeddings · evals</small></div>
          <div class="tile"><h3>AI agents and MCP</h3><p>Agents that take real actions with tool calling. MCP servers that let Claude and other assistants work safely with your app and data.</p><small>MCP · tool calling · Agent SDK</small></div>
          <div class="tile"><h3>AI-assisted engineering</h3><p>Help your team adopt Claude Code and AI coding agents, with the reviews, tests and guardrails that keep quality high.</p><small>Claude Code · AI code review · CI</small></div>
          <div class="tile"><h3>Web and mobile apps</h3><p>Full products from database to App Store. Customer portals, internal tools, SaaS, and iPhone and Android apps from one codebase.</p><small>Rails · Next.js · React Native · Expo</small></div>
          <div class="tile"><h3>Infrastructure and DevOps</h3><p>We set up and run it all: cloud, databases, deploys, monitoring, backups and security. You don't need a separate ops team, and costs stay in check.</p><small>AWS · Terraform · Cloudflare · Railway</small></div>
          <div class="tile"><h3>Contract engineering</h3><p>A senior engineer embedded in your team. Architecture, hard bugs, performance, and getting stuck projects moving.</p><small>Rails · TypeScript · Go · Elixir</small></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>From first call to launch.</h2></div>
        <ol class="steps">
          <li><h3>Talk</h3><p>A free 30-minute call about what you need.</p></li>
          <li><h3>Scope</h3><p>A short written plan with milestones and a clear price.</p></li>
          <li><h3>Build</h3><p>Working software every week that you can click through.</p></li>
          <li><h3>Launch and grow</h3><p>We deploy it, watch over it, and keep improving it as you grow.</p></li>
        </ol>
      </div>
    </section>

    <section class="scale">
      <div class="wrap">
        <div class="head"><h2>Why "Scale"?</h2><p>Launching is the start. When your users go from hundreds to millions, we're still here, and the software keeps up.</p></div>
        <div class="calm-grid">
          <div class="calm-item">
            <h3>Ready to grow</h3>
            <p>Built from day one to handle ten times the traffic. Caching, queues and databases that scale when you need them, without a rewrite.</p>
          </div>
          <div class="calm-item">
            <h3>Stays up</h3>
            <p>Clear uptime targets, monitoring and alerts, safe deploys with automatic rollback, and backups that are actually tested.</p>
          </div>
          <div class="calm-item">
            <h3>Here for the long run</h3>
            <p>The engineer who built it keeps looking after it. Ongoing support, regular check-ins, and a partner who knows your system inside out.</p>
          </div>
        </div>
        <div class="proof">
          <span class="proof-label">Done before</span>
          <div class="stats">
            <div><b>12M</b><span>requests a week on a workforce scheduling platform</span></div>
            <div><b>60s → &lt;1s</b><span>API response times at Indeed, after redesigning data access and caching</span></div>
            <div><b>NHS</b><span>one of the UK's first generative-AI pipelines in a live clinical workflow</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="wrap">
        <h2>Hi, I'm Raj.</h2>
        <div class="letter">
          <p>I started Zen Scale to build software the way I like to work: carefully, in plain English, and without the layers that slow projects down.</p>
          <p>I've spent 15+ years building systems that have to stay up and stay correct under real load. Today most of my work is AI: shipping LLM features to production, building MCP connectors, and engineering with Claude every day, with the reviews and tests that keep it trustworthy.</p>
          <div class="sectors"><span>Gaming</span><span>Housing</span><span>Fraud detection</span><span>Workforce platforms</span><span>Consumer apps</span></div>
        </div>
      </div>
    </section>

    <section class="quotes">
      <div class="wrap">
        <div class="head"><h2>From people who've worked with Raj.</h2></div>
        <div class="quote-grid">
          <figure class="quote">
            <blockquote>Raj is the rare engineer who is as aware of the human element of software development as he is the technical. … Raj embodies the Tech Lead attitude, and I wouldn't hesitate to work with him again.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/jonathan-e-barrett/" target="_blank" rel="noopener">Jonathan Barrett</a><span>Software Engineering Manager · Indeed</span></figcaption>
          </figure>
          <figure class="quote">
            <blockquote>He's one of those engineers who just makes everything better. … He didn't just code features, he really understood the problems we were solving.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/davidslv/" target="_blank" rel="noopener">David Silva</a><span>Senior Backend Engineer · Indeed</span></figcaption>
          </figure>
          <figure class="quote">
            <blockquote>Raj is an exceptional engineering partner: proactive, responsive, and always willing to jump in to help solve problems. He brings clarity to complex situations, asks the right questions, and ensures everyone is aligned before moving forward.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/palak13/" target="_blank" rel="noopener">Palak Jain</a><span>Senior Product Manager</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <div class="box">
          <h2>Have something in mind? Let's talk.</h2>
          <div class="email-row"><a class="email" id="email" href="mailto:raj@zen-scale.io">raj@zen-scale.io</a><button class="copy-btn" id="copy" type="button">Copy</button></div>
          <p class="hint">Tell us a little about the project and your timeline. We reply within two working days.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div>ZEN SCALE LTD · Registered in England &amp; Wales · Company no. 16398455<br>71–75 Shelton Street, Covent Garden, London WC2H 9JQ</div>
      <div>© {year} Zen Scale Ltd</div>
    </div>
  </footer>
  <script is:inline>
  document.querySelectorAll('[data-scope]').forEach(function (el) {
    var frame = 0;
    el.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var x = e.clientX, y = e.clientY;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(function () {
        var r = el.getBoundingClientRect();
        el.style.setProperty('--px', ((x - r.left) / r.width - 0.5).toFixed(3));
        el.style.setProperty('--py', ((y - r.top) / r.height - 0.5).toFixed(3));
      });
    });
    el.addEventListener('pointerleave', function () { el.style.setProperty('--px', 0); el.style.setProperty('--py', 0); });
  });
  document.getElementById('copy').addEventListener('click', function () {
    var b = this;
    function sel() { var r = document.createRange(); r.selectNodeContents(document.getElementById('email')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Selected'; }
    try { navigator.clipboard.writeText('raj@zen-scale.io').then(function () { b.textContent = 'Copied'; }, sel); } catch (e) { sel(); }
  });
  </script>
</Layout>
