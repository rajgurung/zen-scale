---
import Layout from '../layouts/Layout.astro';

const year = new Date().getFullYear();
const mailto = 'mailto:raj@zen-scale.io?subject=Project%20enquiry';
const booking = 'https://cal.com/zenscale/intro';
---

<Layout
  title="Zen Scale · AI engineering studio in London"
  description="AI features, web and mobile apps, and the infrastructure behind them, built and run by Raj Gurung, an engineer who took generative AI live in NHS hospitals."
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap">
      <a class="mark" href="#top"><b aria-hidden="true"></b>Zen Scale</a>
      <nav aria-label="Main">
        <a href="#proof">Proof</a><a href="#services">Services</a><a href="#work">Work</a><a href="#about">About</a>
        <a class="nav-cta" href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="band hero" id="top" data-scope>
    <div class="sun pl" style="--d:40" aria-hidden="true"></div>
    <div class="wrap">
      <span class="pill">AI engineering studio · London</span>
      <h1>AI-powered software, built and run by <span>the engineer you talk to.</span></h1>
      <p class="lede">I build AI features, web and mobile apps, and the infrastructure behind them for startups and SMEs, then stay on to keep them running. Most recently I built an automated AI pipeline that drafts radiology reports, now live in NHS hospitals.</p>
      <div class="ctas"><a class="btn primary" href={mailto}>Email me</a><a class="btn" href={booking} target="_blank" rel="noopener">Book a free call</a></div>
      <div class="who"><span class="av" aria-hidden="true">R</span>Raj Gurung, founder. 15 years building production software.</div>
    </div>
  </div>

  <main id="main">
    <section id="proof" class="sec">
      <div class="wrap">
        <div class="head"><span class="eyebrow">01 · Proof</span><h2>Systems I've built and run in production.</h2><p>Before Zen Scale I was a technical lead at Hexarad and Indeed. Here's what I built there.</p></div>
        <div class="cases">
          <article class="case">
            <b class="fig">AI orchestration</b>
            <h3>An AI pipeline that drafts radiology reports, live in five months.</h3>
            <p>CT scans come in, a vision-language model drafts the report, safety checks decide whether it can be used, and a radiologist reviews it. I designed and led the whole automated pipeline and the AWS infrastructure under it. It now runs in live NHS clinical workflows.</p>
            <span class="case-meta">Hexarad · Technical lead</span>
          </article>
          <article class="case">
            <b class="fig">Built to scale</b>
            <h3>From over a minute to under a second.</h3>
            <p>Reworked the slowest core APIs on a hiring platform serving 12M+ requests a week, and led the integration of an ML decisioning model. Also led the enterprise rollout behind multi-million-pound contracts.</p>
            <span class="case-meta">Indeed · Technical lead</span>
          </article>
          <article class="case">
            <b class="fig">Reliable by design</b>
            <h3>A fast-growing platform kept stable, all the way to acquisition.</h3>
            <p>Joined Syft as an early engineer and led its workforce, employer and agency products. Owned production stability as usage grew, and through its acquisition by Indeed.</p>
            <span class="case-meta">Syft → Indeed · Senior engineer</span>
          </article>
        </div>
        <div class="quote-grid">
          <figure class="quote">
            <blockquote>Raj is the rare engineer who is as aware of the human element of software development as he is the technical. … I wouldn't hesitate to work with him again.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/jonathan-e-barrett/" target="_blank" rel="noopener">Jonathan Barrett</a><span>Engineering Manager at Indeed, managed Raj</span></figcaption>
          </figure>
          <figure class="quote">
            <blockquote>An exceptional engineering partner: proactive, responsive, and always willing to jump in to help solve problems. He brings clarity to complex situations.</blockquote>
            <figcaption><a href="https://www.linkedin.com/in/palak13/" target="_blank" rel="noopener">Palak Jain</a><span>Senior Product Manager, worked with Raj</span></figcaption>
          </figure>
        </div>
        <p class="nudge">Want this for your product? <a href={booking} target="_blank" rel="noopener">Book a free call →</a></p>
      </div>
    </section>

    <section id="services" class="sec tint">
      <div class="wrap">
        <div class="head"><span class="eyebrow">02 · Services</span><h2>What I can do for you.</h2><p>From the first idea to running in production.</p></div>
        <div class="tiles">
          <div class="tile"><h3>AI in your product</h3><p>Add Claude or OpenAI to your product: smart suggestions, document extraction, search over your own content, and agents that take real actions through MCP. Tested so the answers stay reliable.</p><small>Claude · OpenAI · MCP · evals</small></div>
          <div class="tile"><h3>Web and mobile apps</h3><p>Full products from database to App Store. Customer portals, internal tools, SaaS, and iPhone and Android apps from one codebase.</p><small>Rails · Next.js · React Native</small></div>
          <div class="tile"><h3>Infrastructure that stays up</h3><p>I set up and run it all: cloud, databases, deploys, monitoring, backups and security. Clear uptime targets and alerts, so problems get fixed before your users notice.</p><small>AWS · Terraform · Cloudflare</small></div>
          <div class="tile"><h3>A senior engineer in your team</h3><p>Architecture, hard bugs, performance, and getting stuck projects moving. I can also help your team adopt Claude Code and AI coding agents safely.</p><small>Rails · TypeScript · Go · Claude Code</small></div>
        </div>
      </div>
    </section>

    <section id="work" class="sec">
      <div class="wrap">
        <div class="head"><span class="eyebrow">03 · Work</span><h2>Products I've built and run.</h2><p>Each one is calm to use: a few clear screens, plain labels, and one obvious next step. You can try them today.</p></div>
        <article class="product" data-scope>
          <div class="copy">
            <span class="status">● Live on web · iOS coming soon</span>
            <h3>Softly. Life admin, handled softly.</h3>
            <p>A task manager for bills, appointments and renewals. Type or say a task in your own words and AI turns it into a reminder, then suggests what's due next.</p>
            <div class="chips"><span>Claude</span><span>Voice input</span><span>React Native</span></div>
            <a class="btn" href="https://mysoftly.app" target="_blank" rel="noopener">Visit mysoftly.app ↗</a>
          </div>
          <div class="stage">
            <div class="blob pl" style="--d:8" aria-hidden="true"></div>
            <div class="pl" style="--d:18"><div class="phone"><img src="/images/softly-home.jpg" width="414" height="900" alt="Softly home screen showing suggestions and upcoming tasks"></div></div>
            <div class="float f1 pl" style="--d:34" aria-hidden="true"><b>Renew car insurance</b><span>Wed 10 Jun · Car</span></div>
            <div class="float f2 pl" style="--d:42" aria-hidden="true"><b>Pay rent</b><span>Tue 30 Jun · Finance</span></div>
          </div>
        </article>
        <div class="more">
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/collab.jpg" width="1100" height="687" loading="lazy" alt="Collab task board with swimlanes for three projects"></div>
              <div class="bubble pl" style="--d:26" aria-hidden="true"><i>M</i><span>Draft is ready. <b>@raj</b> can you look?</span></div>
            </div>
            <div class="mini-copy">
              <h3>Collab</h3>
              <p>One workspace for small teams: roadmap, tasks, notes and chat. Connect Claude and it plans and updates tasks for you.</p>
              <div class="chips"><span>Rust</span><span>HTMX</span><span>MCP</span></div>
              <a class="go" href="https://collab.zen-scale.io" target="_blank" rel="noopener">Try Collab ↗</a>
            </div>
          </article>
          <article class="mini" data-scope>
            <div class="shot">
              <div class="pl" style="--d:8"><img src="/images/compress.jpg" width="1100" height="733" loading="lazy" alt="Compress home screen: make PDFs and JPGs smaller, nothing is uploaded"></div>
              <div class="bubble lock pl" style="--d:26" aria-hidden="true"><i>✓</i><span>Files stay on your device</span></div>
            </div>
            <div class="mini-copy">
              <h3>Compress</h3>
              <p>Make PDFs and JPGs smaller right in your browser. Files never leave your device, and it works offline.</p>
              <div class="chips"><span>WebAssembly</span><span>Offline</span><span>Open source</span></div>
              <a class="go" href="https://compress.zen-scale.io" target="_blank" rel="noopener">Try Compress ↗</a>
            </div>
          </article>
          <article class="mini game" data-scope>
            <div class="g-stage">
              <div class="g-glow" aria-hidden="true"></div>
              <div class="g-title pl" style="--d:6" aria-hidden="true">Warden<br>Zero</div>
              <div class="g-enemy left pl" style="--d:14" aria-hidden="true"><img src="/images/grunt.webp" width="256" height="256" loading="lazy" alt=""></div>
              <div class="g-enemy right pl" style="--d:14" aria-hidden="true"><img src="/images/runner.webp" width="256" height="256" loading="lazy" alt="" style="transform:scaleX(-1)"></div>
              <div class="g-hero pl" style="--d:26"><img src="/images/warden.webp" width="900" height="1196" loading="lazy" alt="The Warden, an armoured soldier holding a rifle"></div>
              <div class="g-fade" aria-hidden="true"></div>
            </div>
            <div class="mini-copy">
              <h3>Warden Zero</h3>
              <p>An arena shooter that runs in your browser. Survive eight waves and bring down the Colossus.</p>
              <div class="chips"><span>Unity 6</span><span>WebGL</span><span>Touch</span></div>
              <a class="go" href="https://rajgurung.me/game" target="_blank" rel="noopener">Play it ↗</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="sec tint">
      <div class="wrap">
        <div class="head"><span class="eyebrow">04 · How it works</span><h2>How a project runs.</h2></div>
        <ol class="steps">
          <li><h3>Talk</h3><p><a href={booking} target="_blank" rel="noopener">Book a free 30-minute call</a>, or email me.</p></li>
          <li><h3>Scope</h3><p>A written plan with milestones and a fixed price. Projects start from £5k.</p></li>
          <li><h3>Build</h3><p>Working software every week that you can click through.</p></li>
          <li><h3>Run and support</h3><p>I deploy it, monitor it and keep improving it as you grow, from £500 a month. Same engineer, no handover.</p></li>
        </ol>
        <p class="nudge">Want this for your product? <a href={booking} target="_blank" rel="noopener">Book a free call →</a></p>
      </div>
    </section>

    <section id="about" class="sec">
      <div class="wrap about">
        <div class="head"><img class="headshot" src="/images/raj.webp" alt="Raj Gurung" width="400" height="400" loading="lazy" /><span class="eyebrow">05 · About</span><h2>Hi, I'm Raj.</h2></div>
        <div class="letter">
          <p>I started Zen Scale to build software the way I like to work: carefully, in plain English, with no layers between you and the engineer.</p>
          <p>Most of my work today is AI: LLM features in production, MCP connectors, and engineering with Claude every day, with the reviews and tests that keep it trustworthy.</p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <div class="box">
          <h2>Tell me what you're building.</h2>
          <ul class="prompts">
            <li>What your product does</li>
            <li>What you need: AI, an app, infrastructure or ongoing support</li>
            <li>Your timeline and rough budget</li>
          </ul>
          <div class="email-row"><a class="email" id="email" href={mailto}>raj@zen-scale.io</a><button class="copy-btn" id="copy" type="button">Copy</button></div>
          <a class="book-btn" href={booking} target="_blank" rel="noopener">Or book a free 30-minute call →</a>
          <p class="hint">I reply within one working day. Projects from £5k · ongoing support from £500 a month.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div>ZEN SCALE LTD · Registered in England &amp; Wales · Company no. 16398455<br>71–75 Shelton Street, Covent Garden, London WC2H 9JQ</div>
      <div>© {year} Zen Scale Ltd</div>
    </div>
  </footer>
  <script is:inline>
  document.querySelectorAll('[data-scope]').forEach(function (el) {
    var frame = 0;
    el.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var x = e.clientX, y = e.clientY;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(function () {
        var r = el.getBoundingClientRect();
        el.style.setProperty('--px', ((x - r.left) / r.width - 0.5).toFixed(3));
        el.style.setProperty('--py', ((y - r.top) / r.height - 0.5).toFixed(3));
      });
    });
    el.addEventListener('pointerleave', function () { el.style.setProperty('--px', 0); el.style.setProperty('--py', 0); });
  });

  // Highlight the nav link for the section in view.
  var links = {};
  document.querySelectorAll('nav a[href^="#"]').forEach(function (a) { links[a.getAttribute('href').slice(1)] = a; });
  var spy = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      Object.values(links).forEach(function (a) { a.removeAttribute('aria-current'); });
      if (links[e.target.id]) links[e.target.id].setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id]').forEach(function (s) { spy.observe(s); });

  document.getElementById('copy').addEventListener('click', function () {
    var b = this;
    function sel() { var r = document.createRange(); r.selectNodeContents(document.getElementById('email')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Selected'; }
    try { navigator.clipboard.writeText('raj@zen-scale.io').then(function () { b.textContent = 'Copied'; }, sel); } catch (e) { sel(); }
  });
  </script>
</Layout>
